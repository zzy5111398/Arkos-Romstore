# ---------------------------------------------------------------------------
# ark-romstore
# ---------------------------------------------------------------------------

# 项目内部数据（工作日志 / 长期笔记）
# ⚠️ 内含掌机登录口令、局域网 IP、NAS 路径等敏感信息，**绝不允许入库**
.workbuddy/

# Python 编译缓存
__pycache__/
*.py[cod]
*.pyo
*.pyd

# 开发期只读探查脚本（与 make-dist.py 的 SKIP_PREFIX = '_' 保持一致）
_*.py
_*.sh
_*.txt

# 分发包产物（make-dist.py 默认生成在项目上一级，这里再兜一层）
*.tar.gz
*.tgz
*.tar
*.zip

# 编辑器 / 操作系统杂项
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
*.orig
*.rej

# 本地临时输出
*.log
*.tmp
.idea/
.vscode/

# 开发期 UI 截图（headless 渲染抓帧用，仅本机调试看）
.shots/
